{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "description": "API Viangola Interprovincial — FastAPI + SQLAlchemy + Alembic",
  "scripts": {
    "dev": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "start": "uv run uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}",
    "db:migrate": "uv run alembic upgrade head",
    "db:seed": "uv run python -m app.seed",
    "db:revision": "uv run alembic revision --autogenerate",
    "test": "uv run pytest"
  }
}
